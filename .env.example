# Copy to .env (bck/.env) and adjust only if your local setup differs.
# See infra/docker-compose.yml for the Postgres container these values match.
# Never put real secrets, API keys, or production values in this file.

# Required — no default, Settings raises ValidationError if unset.
DATABASE_URL=postgresql+asyncpg://satquery:satquery_local_dev@localhost:5432/satquery

# Required — must be > 0 (Field(gt=0)). Max USD spend allowed for the optional
# Bhashini voice-input paid-API path before it must refuse the request.
COST_CEILING=10.0

# Optional — defaults to "INFO" if unset.
# LOG_LEVEL=INFO

# Optional — defaults to "http://localhost:8001" (infra/docker-compose.yml's titiler
# service) if unset.
# TITILER_BASE_URL=http://localhost:8001

# Required — no default, Settings raises ValidationError if unset. Signing secret for
# access/refresh JWTs. Generate a real one: openssl rand -hex 32
JWT_SECRET_KEY=

# Optional — defaults shown. See app/core/config.py for what each one gates.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# AUTH_REQUIRED=true
# AUTH_COOKIE_SECURE=false
# FRONTEND_ORIGINS=http://localhost:5173,http://172.31.22.203:5173

# Optional — Google OAuth sign-in. Register the app at console.cloud.google.com. All three
# must be set together for /auth/google/* to work; leaving any one unset makes those routes
# return a clean 503 "Google sign-in not configured" instead of failing at startup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional — ISRO/Bhuvan CAS SSO. Config slots only — no real Bhuvan endpoint exists yet
# (ISRO must register the app first). The /auth/isro/* route code is real, not stubbed; it
# just returns a clean 503 "ISRO SSO not configured" until every value below is set.
# ISRO_CLIENT_ID=
# ISRO_CLIENT_SECRET=
# ISRO_AUTH_URL=
# ISRO_TOKEN_URL=
# ISRO_USERINFO_URL=
# ISRO_REDIRECT_URI=http://localhost:8000/auth/isro/callback
